<?xml version="1.0" encoding="utf-8"?>
<!-- A screen arriving: fades in while growing slightly into place. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <scale
        android:fromXScale="0.93" android:toXScale="1"
        android:fromYScale="0.93" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="240" />
</set>
