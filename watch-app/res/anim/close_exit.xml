<?xml version="1.0" encoding="utf-8"?>
<!-- A screen leaving: fades out while shrinking slightly. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="160" />
    <scale
        android:fromXScale="1" android:toXScale="0.93"
        android:fromYScale="1" android:toYScale="0.93"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="180" />
</set>
